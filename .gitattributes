* text=auto
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.svg text eol=lf
*.png binary
*.jpg binary
# Golden outputs are compared byte-for-byte; never convert line endings.
tests/golden/** -text
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
docker/* text eol=lf
# Vendored files are pinned by SRI hash; never convert their bytes.
src/blink_visual/server/static/swagger-ui* -text linguist-vendored
src/blink_visual/server/static/htmx* -text linguist-vendored
